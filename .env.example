# Copy to .env. These are placeholders; do NOT put real credentials in Git.
# Local PostgreSQL URL (create this database/user yourself)
DATABASE_URL=postgresql://tickettreat:change_me@127.0.0.1:5432/tickettreat

# Separate API for the web/PWA and Telegram Mini App; keep production bot/API isolated until tested
DEMO_ISOLATED_API=true
APP_ENV=development
DEMO_PAYMENT_MODE=false

# Telegram test bot (required only when running bot or Telegram Mini App)
BOT_TOKEN=
TELEGRAM_MINIAPP_BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=
BACKEND_URL=http://127.0.0.1:8000
WEB_APP_URL=

# Email verification and password reset (disabled until credentials configured)
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
AUTH_CODE_SECRET=

# Account administration (server-only)
GLOBAL_ADMIN_EMAILS=
GLOBAL_ADMIN_RECOVERY_SECRET=
GLOBAL_ADMIN_ACCOUNT_IDS=

# Public API/origin settings (restrict origins when serving publicly)
FRONTEND_ORIGINS=http://localhost:3000
DEMO_PUBLIC_API_URL=http://127.0.0.1:8000

# Next.js frontend/.env.local (separate file, not this Python .env):
# BACKEND_API_URL=http://127.0.0.1:8000

# Service-to-service authentication for the legacy Backend and Telegram Bot:
# 32+ random characters, configured IDENTICALLY in both Railway services.
BOT_API_KEY=

# MFA at-rest encryption key: generate with Python:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set only on the FastAPI service; retain a secure backup of the key.
MFA_ENCRYPTION_KEY=

# Publish only after approving an event-registration retention schedule.
# Unset: any account with tickets must be held for manual privacy review.
PRIVACY_FREE_TICKET_RETENTION_DAYS=

# Offsite backup storage must be a durable encrypted bucket/volume.
# Backups are NOT automatically enabled by adding these settings.
BACKUP_DIR=

# Google OAuth: backend only (never NEXT_PUBLIC_*).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set the same URI on backend + frontend and in Google Cloud OAuth settings.
GOOGLE_REDIRECT_URI=https://tickettreat.eu/api/auth/google/callback

# Timed waitlist seat claim reallocation. Enable on exactly ONE dedicated
# background service/replica after staging migration and real-email rehearsal.
# Other web/API replicas must keep it false.
WAITLIST_OFFER_WORKER_ENABLED=false

# Private S3-compatible media storage for uploaded photos.
# Configure ALL four for private object storage; unset = legacy PostgreSQL.
# Never put keys in NEXT_PUBLIC_ frontend variables.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
