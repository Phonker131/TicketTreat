# Demo API environment example. Add values only in Railway, never in source control.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Global administrator recovery (set real values ONLY on Railway > Demo API > Variables)
# GLOBAL_ADMIN_EMAILS=<admin-email>; add more emails separated by commas
# GLOBAL_ADMIN_RECOVERY_SECRET=<random secret of at least 32 characters>
# GLOBAL_ADMIN_ACCOUNT_IDS=  # optional legacy IDs, normally not needed

# Email verification and password reset require a verified Resend sender.
# Use EMAIL_NOTIFICATIONS_ENABLED=true only after credentials and DNS are verified.
# Existing accounts can verify their email from Profile after logging in.
